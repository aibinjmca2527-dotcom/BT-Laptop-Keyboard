<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/primary_variant" />
                    <stroke android:width="1.5dp" android:color="@color/primary" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="@color/primary_variant" />
                </shape>
            </item>
            <item android:bottom="2.5dp" android:left="0.5dp" android:right="0.5dp" android:top="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/primary" />
                    <stroke android:width="1dp" android:color="@color/primary_variant" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
