<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Standard Typing Key Style -->
    <style name="KeyStandardStyle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_key_selector</item>
        <item name="android:layout_marginStart">1.5dp</item>
        <item name="android:layout_marginEnd">1.5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Function Key (F1-F12) Style -->
    <style name="KeyFunctionStyle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_key_modifier_selector</item>
        <item name="android:layout_marginStart">1.5dp</item>
        <item name="android:layout_marginEnd">1.5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Modifier Key (Shift, Ctrl, Alt, Caps, Tab, Backspace) Style -->
    <style name="KeyModifierStyle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_key_modifier_selector</item>
        <item name="android:layout_marginStart">1.5dp</item>
        <item name="android:layout_marginEnd">1.5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Enter Key Style -->
    <style name="KeyEnterStyle">
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_key_enter_selector</item>
        <item name="android:layout_marginStart">1.5dp</item>
        <item name="android:layout_marginEnd">1.5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
