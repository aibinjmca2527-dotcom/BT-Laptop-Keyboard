<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BluetoothKeyboard" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_keyboard_dark</item>
        <item name="android:navigationBarColor">@color/bg_keyboard_dark</item>
        <item name="android:windowBackground">@color/bg_keyboard_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.BluetoothKeyboard.ActionBar" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/bg_surface</item>
        <item name="colorPrimaryVariant">@color/bg_keyboard_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_keyboard_dark</item>
        <item name="android:navigationBarColor">@color/bg_keyboard_dark</item>
        <item name="android:windowBackground">@color/bg_keyboard_dark</item>
    </style>
</resources>
